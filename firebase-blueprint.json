{
  "entities": {
    "Event": {
      "title": "Event",
      "description": "A scheduled festival event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "day": { "type": "string" },
        "time": { "type": "string" },
        "category": { "type": "string" },
        "name": { "type": "string" },
        "venue": { "type": "string" },
        "description": { "type": "string" },
        "updatedBy": { "type": "string" },
        "updatedByEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["day", "time", "category", "name", "venue", "updatedBy", "updatedByEmail"]
    },
    "Venue": {
      "title": "Venue",
      "description": "A location where events take place",
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "Category": {
      "title": "Category",
      "description": "An event category",
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "Activity": {
      "title": "Activity",
      "description": "A log entries of schedule changes",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "action": { "type": "string", "enum": ["CREATE", "UPDATE", "DELETE"] },
        "eventDetails": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userEmail", "action", "eventDetails", "timestamp"]
    },
    "Admin": {
      "title": "Admin",
      "description": "A user with administrative privileges",
      "type": "object",
      "properties": {
        "email": { "type": "string" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "events": {
      "schema": "Event",
      "description": "Collection of all festival events"
    },
    "venues": {
      "schema": "Venue",
      "description": "Collection of available venues"
    },
    "categories": {
      "schema": "Category",
      "description": "Collection of event categories"
    },
    "activity": {
      "schema": "Activity",
      "description": "Historical log of schedule changes"
    },
    "admins": {
      "schema": "Admin",
      "description": "List of administrative user IDs"
    }
  }
}
